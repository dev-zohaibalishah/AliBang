{{ 'geekbar-product.css' | asset_url | stylesheet_tag }}

<div class="gk-section geekbar-features" id="geekbar-features">
  <div class="page-width">
    {% if section.settings.heading != blank %}
    <h2 class="gk-section-title gk-fade-in">{{ section.settings.heading }}</h2>
    {% endif %}
    
    {% for block in section.blocks %}
    <div class="geekbar-features__card gk-fade-in" {{ block.shopify_attributes }}>
      <div class="geekbar-features__image">
        {% if block.settings.image %}
        {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'geekbar-features__img' }}
        {% else %}
        <div style="width:100%;height:100%;background:linear-gradient(135deg, #1A1D28, #10121A);display:flex;align-items:center;justify-content:center;">
          <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
        {% endif %}
      </div>
      <div class="geekbar-features__info">
        {% if block.settings.tag != blank %}
        <span class="geekbar-hero__tag" style="margin-bottom:16px;">{{ block.settings.tag }}</span>
        {% endif %}
        <h3>{{ block.settings.heading }}</h3>
        <p>{{ block.settings.description }}</p>
        {% if block.settings.button_label != blank %}
        <a href="{{ block.settings.button_link }}" class="button button--secondary" style="margin-top:20px;align-self:flex-start;">{{ block.settings.button_label }}</a>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "GeekBar Product Features",
  "tag": "section",
  "class": "geekbar-features-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "KEY FEATURES"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "FEATURE"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Advanced Technology"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Experience the next generation of innovation with our cutting-edge technology."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GeekBar Product Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "tag": "TECHNOLOGY",
            "heading": "3D CURVED SCREEN",
            "description": "World's first 3D curved full screen display with real-time battery and e-liquid monitoring, featuring stunning cosmic background animations."
          }
        },
        {
          "type": "feature",
          "settings": {
            "tag": "PERFORMANCE",
            "heading": "DUAL MESH COIL SYSTEM",
            "description": "Advanced dual mesh coil heating technology delivers richer, more consistent flavor with every puff, maximizing vapor production."
          }
        },
        {
          "type": "feature",
          "settings": {
            "tag": "POWER",
            "heading": "RAPID USB-C CHARGING",
            "description": "Get back to full power quickly with USB-C fast charging technology. Reach 80% battery in just 20 minutes."
          }
        }
      ]
    }
  ]
}
{% endschema %}
