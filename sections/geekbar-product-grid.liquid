<style>
  .geekbar-products {
    background: var(--gk-bg-primary, #0B0D12);
    padding: 80px 0;
    overflow: hidden;
  }
  .geekbar-products h2 {
    font-size: 2.5rem;
    font-family: var(--gk-font-heading, 'Outfit');
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 40px;
    text-align: center;
    color: white;
  }
  
  .geekbar-products__card {
    background: #12141C;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.3s ease, border-color 0.3s ease;
    display: block;
    height: 100%;
  }
  
  .geekbar-products__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(218, 28, 29, 0.25);
    border-color: rgba(218, 28, 29, 0.3);
  }
  
  /* Padding, centering and white bg for image containers so white-bg vapes look stunning */
  .geekbar-products__image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #FFFFFF;
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }
  
  .geekbar-products__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  
  .geekbar-products__card:hover .geekbar-products__img {
    transform: scale(1.08);
  }
  
  .geekbar-products__info {
    padding: 20px;
  }

  /* Reviews/Stars Rating Container */
  .geekbar-products__rating {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
    font-family: var(--gk-font-body, 'Inter', sans-serif);
  }
  .geekbar-products__rating .stars {
    color: #FFB800;
    font-size: 1.3rem;
    letter-spacing: -1px;
    line-height: 1;
  }
  .geekbar-products__rating .rating-value {
    color: #FFFFFF;
    font-weight: 600;
    font-size: 1.2rem;
  }
  .geekbar-products__rating .rating-count {
    color: #6B7085;
    font-size: 1.2rem;
  }
  
  .geekbar-products__name {
    color: white;
    font-size: 1.4rem;
    font-weight: 600;
    margin: 0 0 10px;
    line-height: 1.4;
    text-transform: uppercase;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: 3.8rem; /* Keeps titles aligned to the same height */
  }
  
  .geekbar-products__price {
    color: #DA1C1D;
    font-weight: 700;
    font-size: 1.6rem;
    margin: 0;
  }
  
  .geekbar-products__card-link {
    text-decoration: none;
    display: block;
  }
  
  .gk-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }
  .gk-badge--new { background: #DA1C1D; color: #FFF; }
  .gk-badge--hot { background: #FF4757; color: #FFF; }
  .gk-badge--best { background: #FFD600; color: #000; }

  .products-swiper-container {
    overflow: visible;
    padding-bottom: 50px;
    position: relative;
  }
  .products-swiper-container .swiper-wrapper {
    display: flex;
    transition-property: transform;
    box-sizing: content-box;
  }
  .products-swiper-container .swiper-slide {
    width: 300px;
    flex-shrink: 0;
    padding: 0 10px;
    height: auto; /* Let cards grow to uniform height */
  }
  
  /* Swiper pagination override */
  .products-swiper-container .swiper-pagination {
    bottom: 10px;
  }
  .products-swiper-container .swiper-pagination-bullet-active {
    background: #DA1C1D !important;
  }

  @media screen and (max-width: 768px) {
    .products-swiper-container .swiper-slide {
      width: 80vw;
    }
  }
</style>

<div class="gk-section geekbar-products" id="geekbar-products">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="gk-section-title gk-fade-in">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="gk-section-subtitle gk-fade-in" style="text-align:center;color:var(--gk-text-secondary);margin-top:-40px;margin-bottom:50px;font-size:1.4rem;">{{ section.settings.subheading }}</p>
    {% endif %}
    
    <div class="products-swiper-container">
      <div class="swiper-wrapper">
        {% assign collection = collections[section.settings.collection] %}
        {% if collection != blank %}
          {% for product in collection.products limit: section.settings.products_to_show %}
            <div class="swiper-slide">
              <div class="geekbar-products__card gk-fade-in" style="--animation-order: {{ forloop.index }};">
                <a href="{{ product.url }}" class="geekbar-products__card-link">
                  <div class="geekbar-products__image">
                    {% if product.featured_image %}
                      {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'geekbar-products__img' }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                    {% if product.tags contains 'new' %}
                      <span class="gk-badge gk-badge--new">NEW</span>
                    {% elsif product.tags contains 'hot' %}
                      <span class="gk-badge gk-badge--hot">HOT</span>
                    {% elsif product.tags contains 'bestseller' %}
                      <span class="gk-badge gk-badge--best">BESTSELLER</span>
                    {% endif %}
                  </div>
                  <div class="geekbar-products__info">
                    <!-- Reviews/Stars Rating Container -->
                    <div class="geekbar-products__rating">
                      <span class="stars">
                        {% assign rating = 5 %}
                        {%- if product.metafields.reviews.rating.value != blank -%}
                          {% assign rating = product.metafields.reviews.rating.value.rating | round %}
                        {%- endif -%}
                        {% for i in (1..5) %}
                          {% if i <= rating %}★{% else %}☆{% endif %}
                        {% endfor %}
                      </span>
                      <span class="rating-value">
                        {%- if product.metafields.reviews.rating.value != blank -%}
                          {{ product.metafields.reviews.rating.value.rating }}
                        {%- else -%}
                          5.0
                        {%- endif -%}
                      </span>
                      <span class="rating-count">
                        {%- if product.metafields.reviews.rating_count != blank -%}
                          ({{ product.metafields.reviews.rating_count }})
                        {%- else -%}
                          (36)
                        {%- endif -%}
                      </span>
                    </div>

                    <h3 class="geekbar-products__name">{{ product.title }}</h3>
                    <p class="geekbar-products__price">{{ product.price | money }}</p>
                  </div>
                </a>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <!-- Demo products when no collection selected -->
          {% assign demo_titles = "Juicy Peach Ice,Grape Ice,Strawberry Watermelon,Blue Razz Ice,Sour Apple Ice,Tropical Mango" | split: "," %}
          {% for i in (1..6) %}
            {% assign img_name = 'product-img-' | append: i | append: '.jpg' %}
            {% assign title_index = i | minus: 1 %}
            <div class="swiper-slide">
              <div class="geekbar-products__card gk-fade-in">
                <div class="geekbar-products__image">
                  <img src="{{ img_name | asset_url }}" alt="{{ demo_titles[title_index] }}" class="geekbar-products__img" loading="lazy">
                  {% if i == 1 %}<span class="gk-badge gk-badge--new">NEW</span>{% elsif i == 2 %}<span class="gk-badge gk-badge--hot">HOT</span>{% elsif i == 3 %}<span class="gk-badge gk-badge--best">BESTSELLER</span>{% endif %}
                </div>
                <div class="geekbar-products__info">
                  <div class="geekbar-products__rating">
                    <span class="stars">★★★★★</span>
                    <span class="rating-value">5.0</span>
                    <span class="rating-count">({% if i == 1 %}142{% elsif i == 2 %}94{% elsif i == 3 %}218{% else %}48{% endif %})</span>
                  </div>
                  <h3 class="geekbar-products__name">ALIBARBAR 35000 Puffs</h3>
                  <p style="color:var(--gk-text-secondary,#a0a5b5);font-size:1.3rem;margin-bottom:8px;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden;">{{ demo_titles[title_index] }}</p>
                  <p class="geekbar-products__price">$29.99</p>
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
      <div class="swiper-pagination"></div>
    </div>
    
    {% if section.settings.show_view_all and section.settings.collection != blank %}
      <div style="text-align:center;margin-top:50px;">
        <a href="{{ collections[section.settings.collection].url }}" class="button button--secondary">View All Products</a>
      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof Swiper !== 'undefined') {
      new Swiper('.products-swiper-container', {
        slidesPerView: 'auto',
        spaceBetween: 20,
        loop: true,
        autoplay: {
          delay: 3500,
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        },
        pagination: {
          el: '.products-swiper-container .swiper-pagination',
          clickable: true,
        },
      });
    }
  });
</script>

{% schema %}
{
  "name": "GeekBar Product Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Products"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": false,
      "label": "Show 'View all' button"
    }
  ],
  "presets": [
    {
      "name": "GeekBar Product Slider"
    }
  ]
}
{% endschema %}
