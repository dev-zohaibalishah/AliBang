<style>
  .geekbar-products { background: var(--gk-bg-primary, #0B0D12); padding: 80px 0; overflow: hidden; }
  .geekbar-products h2 { font-size: 2.5rem; font-family: var(--gk-font-heading, 'Outfit'); font-weight: 800; text-transform: uppercase; margin-bottom: 40px; text-align: center; color: white; }
  .geekbar-products__card { background: var(--gk-bg-card, #1A1D28); border-radius: 16px; overflow: hidden; border: 1px solid rgba(255,255,255,0.08); transition: transform 0.3s, box-shadow 0.3s; }
  .geekbar-products__card:hover { transform: translateY(-6px); box-shadow: 0 0 25px rgba(218,28,29,0.3); }
  .geekbar-products__image { position: relative; aspect-ratio: 1; overflow: hidden; background: #10121A; }
  .geekbar-products__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .geekbar-products__card:hover .geekbar-products__img { transform: scale(1.08); }
  .geekbar-products__info { padding: 20px; }
  .geekbar-products__name { color: white; font-size: 1.5rem; font-weight: 600; margin: 0 0 8px; }
  .geekbar-products__price { color: #DA1C1D; font-weight: 700; font-size: 1.6rem; margin: 0; }
  .geekbar-products__card-link { text-decoration: none; display: block; }
  .gk-badge { position: absolute; top: 12px; left: 12px; z-index: 2; padding: 4px 8px; border-radius: 4px; font-size: 1.2rem; font-weight: bold; }
  .gk-badge--new { background: #DA1C1D; color: #FFF; }
  .gk-badge--hot { background: #FF4757; color: #FFF; }
  .gk-badge--best { background: #FFD600; color: #000; }

  .products-swiper-container { overflow: visible; padding-bottom: 50px; position: relative; }
  .products-swiper-container .swiper-wrapper { display: flex; transition-property: transform; box-sizing: content-box; }
  .products-swiper-container .swiper-slide { width: 300px; flex-shrink: 0; padding: 0 10px; }
  
  @media screen and (max-width: 768px) {
    .products-swiper-container .swiper-slide { width: 80vw; }
  }
</style>

<div class="gk-section geekbar-products" id="geekbar-products">
  <div class="page-width">
    {% if section.settings.heading != blank %}
    <h2 class="gk-section-title gk-fade-in">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
    <p class="gk-section-subtitle gk-fade-in" style="text-align:center;color:var(--gk-text-secondary);margin-top:-40px;margin-bottom:50px;font-size:1.1rem;">{{ section.settings.subheading }}</p>
    {% endif %}
    
    <div class="products-swiper-container">
      <div class="swiper-wrapper">
        {% assign collection = collections[section.settings.collection] %}
        {% if collection != blank %}
          {% for product in collection.products limit: section.settings.products_to_show %}
          <div class="swiper-slide">
            <div class="geekbar-products__card gk-fade-in" style="--animation-order: {{ forloop.index }};">
              <a href="{{ product.url }}" class="geekbar-products__card-link">
                <div class="geekbar-products__image">
                  {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'geekbar-products__img' }}
                  {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                  {% if product.tags contains 'new' %}
                  <span class="gk-badge gk-badge--new">NEW</span>
                  {% elsif product.tags contains 'hot' %}
                  <span class="gk-badge gk-badge--hot">HOT</span>
                  {% elsif product.tags contains 'bestseller' %}
                  <span class="gk-badge gk-badge--best">BESTSELLER</span>
                  {% endif %}
                </div>
                <div class="geekbar-products__info">
                  <h3 class="geekbar-products__name">{{ product.title }}</h3>
                  <p class="geekbar-products__price">{{ product.price | money }}</p>
                </div>
              </a>
            </div>
          </div>
          {% endfor %}
        {% else %}
          <!-- Demo products when no collection selected -->
          {% assign demo_titles = "Juicy Peach Ice | Grape Ice,Strawberry Watermelon,Blue Razz Ice,Sour Apple Ice,Tropical Mango,Cool Mint" | split: "," %}
          {% for i in (1..6) %}
          {% assign img_name = 'product-img-' | append: i | append: '.jpg' %}
          {% assign title_index = i | minus: 1 %}
          <div class="swiper-slide">
            <div class="geekbar-products__card gk-fade-in">
              <div class="geekbar-products__image">
                <img src="{{ img_name | asset_url }}" alt="{{ demo_titles[title_index] }}" class="geekbar-products__img" loading="lazy">
                {% if i == 1 %}<span class="gk-badge gk-badge--new">NEW</span>{% elsif i == 2 %}<span class="gk-badge gk-badge--hot">HOT</span>{% elsif i == 3 %}<span class="gk-badge gk-badge--best">BESTSELLER</span>{% endif %}
              </div>
              <div class="geekbar-products__info">
                <h3 class="geekbar-products__name">ALIBARBAR 35000 Puffs</h3>
                <p style="color:var(--gk-text-secondary,#a0a5b5);font-size:1.3rem;margin-bottom:6px;">{{ demo_titles[title_index] }}</p>
                <p class="geekbar-products__price">$29.99</p>
              </div>
            </div>
          </div>
          {% endfor %}
        {% endif %}
      </div>
      <div class="swiper-pagination"></div>
    </div>
    
    {% if section.settings.show_view_all and section.settings.collection != blank %}
    <div style="text-align:center;margin-top:50px;">
      <a href="{{ collections[section.settings.collection].url }}" class="button button--secondary">View All Products</a>
    </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof Swiper !== 'undefined') {
      new Swiper('.products-swiper-container', {
        slidesPerView: 'auto',
        spaceBetween: 20,
        loop: true,
        autoplay: {
          delay: 3000,
          disableOnInteraction: false,
        },
        pagination: {
          el: '.products-swiper-container .swiper-pagination',
          clickable: true,
        },
      });
    }
  });
</script>

{% schema %}
{
  "name": "GeekBar Product Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Products"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": false,
      "label": "Show 'View all' button"
    }
  ],
  "presets": [
    {
      "name": "GeekBar Product Slider"
    }
  ]
}
{% endschema %}
