<style>
  .geekbar-products__card { background: var(--gk-bg-card, #1A1D28); border-radius: 16px; overflow: hidden; border: 1px solid rgba(255,255,255,0.08); transition: transform 0.3s, box-shadow 0.3s; }
  .geekbar-products__card:hover { transform: translateY(-6px); box-shadow: 0 0 25px rgba(0,229,255,0.2); }
  .geekbar-products__image { position: relative; aspect-ratio: 1; overflow: hidden; background: #10121A; }
  .geekbar-products__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .geekbar-products__card:hover .geekbar-products__img { transform: scale(1.08); }
  .geekbar-products__info { padding: 20px; }
  .geekbar-products__name { color: white; font-size: 1rem; font-weight: 600; margin: 0 0 8px; }
  .geekbar-products__price { color: #00E5FF; font-weight: 700; font-size: 1.1rem; margin: 0; }
  .geekbar-products__card-link { text-decoration: none; display: block; }
  .gk-badge { position: absolute; top: 12px; left: 12px; z-index: 2; padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: bold; }
  .gk-badge--new { background: #00E5FF; color: #000; }
  .gk-badge--hot { background: #FF4757; color: #FFF; }
  .gk-badge--best { background: #FFD600; color: #000; }
  @media screen and (max-width: 990px) {
    .geekbar-products__grid { grid-template-columns: repeat(3, 1fr) !important; }
  }
  @media screen and (max-width: 750px) {
    .geekbar-products__grid { grid-template-columns: repeat(2, 1fr) !important; }
  }
</style>

<div class="gk-section geekbar-products" id="geekbar-products">
  <div class="page-width">
    {% if section.settings.heading != blank %}
    <h2 class="gk-section-title gk-fade-in">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
    <p class="gk-section-subtitle gk-fade-in" style="text-align:center;color:var(--gk-text-secondary);margin-top:-40px;margin-bottom:50px;font-size:1.1rem;">{{ section.settings.subheading }}</p>
    {% endif %}
    
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank %}
    <div class="geekbar-products__grid" style="display:grid;grid-template-columns:repeat({{ section.settings.columns }}, 1fr);gap:24px;">
      {% for product in collection.products limit: section.settings.products_to_show %}
      <div class="geekbar-products__card gk-fade-in" style="--animation-order: {{ forloop.index }};">
        <a href="{{ product.url }}" class="geekbar-products__card-link">
          <div class="geekbar-products__image">
            {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'geekbar-products__img' }}
            {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
            {% if product.tags contains 'new' %}
            <span class="gk-badge gk-badge--new">NEW</span>
            {% elsif product.tags contains 'hot' %}
            <span class="gk-badge gk-badge--hot">HOT</span>
            {% elsif product.tags contains 'bestseller' %}
            <span class="gk-badge gk-badge--best">BESTSELLER</span>
            {% endif %}
          </div>
          <div class="geekbar-products__info">
            <h3 class="geekbar-products__name">{{ product.title }}</h3>
            <p class="geekbar-products__price">{{ product.price | money }}</p>
          </div>
        </a>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <!-- Placeholder when no collection selected -->
    <div class="geekbar-products__grid" style="display:grid;grid-template-columns:repeat({{ section.settings.columns }}, 1fr);gap:24px;">
      {% for i in (1..section.settings.products_to_show) %}
      <div class="geekbar-products__card gk-fade-in">
        <div class="geekbar-products__image">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
        <div class="geekbar-products__info">
          <h3 class="geekbar-products__name">Sample Product {{ i }}</h3>
          <p class="geekbar-products__price">$29.99</p>
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    
    {% if section.settings.show_view_all and section.settings.collection != blank %}
    <div style="text-align:center;margin-top:50px;">
      <a href="{{ collections[section.settings.collection].url }}" class="button button--secondary">View All Products</a>
    </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "GeekBar Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OUR PRODUCTS"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "select",
      "id": "columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4",
      "label": "Columns on desktop"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show 'View all' button"
    }
  ],
  "presets": [
    {
      "name": "GeekBar Product Grid"
    }
  ]
}
{% endschema %}
