<style>
  .geekbar-flavors__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 40px; }
  .geekbar-flavors__card { border-radius: 16px; overflow: hidden; aspect-ratio: 1; position: relative; cursor: pointer; transition: transform 0.3s; display: block; text-decoration: none; }
  .geekbar-flavors__card:hover { transform: scale(1.05); }
  .geekbar-flavors__name { position: absolute; bottom: 20px; left: 20px; color: white; font-weight: 700; font-size: 1.1rem; text-shadow: 0 2px 4px rgba(0,0,0,0.5); margin: 0; }
  .geekbar-flavors__img { width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; mix-blend-mode: overlay; opacity: 0.6; }
  @media screen and (max-width: 990px) { .geekbar-flavors__grid { grid-template-columns: repeat(3, 1fr); } }
  @media screen and (max-width: 750px) { .geekbar-flavors__grid { grid-template-columns: repeat(2, 1fr); } }
</style>

<div class="gk-section geekbar-flavors">
  <div class="page-width">
    {% if section.settings.heading != blank %}
    <h2 class="gk-section-title gk-fade-in" style="text-align: center; color: white;">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
    <p class="gk-section-subtitle gk-fade-in" style="text-align: center; color: #A0A5B5;">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="geekbar-flavors__grid">
      {% for block in section.blocks %}
      {% assign flavor_color = block.settings.color | default: '#FF6B6B' %}
      <a {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} class="geekbar-flavors__card gk-fade-in" {{ block.shopify_attributes }} style="background: linear-gradient(135deg, {{ flavor_color }}, #10121A); box-shadow: 0 10px 20px rgba(0,0,0,0.2);" onmouseover="this.querySelector('.hover-overlay').style.opacity='1'; this.style.boxShadow='0 0 30px {{ flavor_color }}'" onmouseout="this.querySelector('.hover-overlay').style.opacity='0'; this.style.boxShadow='0 10px 20px rgba(0,0,0,0.2)'">
        {% if block.settings.image != blank %}
        {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'geekbar-flavors__img' }}
        {% endif %}
        <div class="hover-overlay" style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.8), transparent); opacity: 0; transition: opacity 0.3s;"></div>
        <h3 class="geekbar-flavors__name">{{ block.settings.name }}</h3>
      </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "GeekBar Flavor Universe",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "EXPLORE OUR FLAVORS"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "blocks": [
    {
      "type": "flavor",
      "name": "Flavor",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Flavor Name",
          "default": "Flavor Name"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#FF6B6B"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GeekBar Flavor Universe",
      "blocks": [
        { "type": "flavor", "settings": { "name": "Sour Apple", "color": "#39FF14" } },
        { "type": "flavor", "settings": { "name": "Blue Razz", "color": "#00A8FF" } },
        { "type": "flavor", "settings": { "name": "Watermelon", "color": "#FF4757" } },
        { "type": "flavor", "settings": { "name": "Mango", "color": "#FFD600" } },
        { "type": "flavor", "settings": { "name": "Grape", "color": "#9B59B6" } },
        { "type": "flavor", "settings": { "name": "Mint", "color": "#00E5FF" } },
        { "type": "flavor", "settings": { "name": "Strawberry", "color": "#FF00E5" } },
        { "type": "flavor", "settings": { "name": "Peach", "color": "#FF8C42" } }
      ]
    }
  ]
}
{% endschema %}
