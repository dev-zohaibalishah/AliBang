<style>
  .geekbar-tech__image { max-width: 800px; margin: 0 auto 60px; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
  .geekbar-tech__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .geekbar-tech__card { background: rgba(26,29,40,0.85); backdrop-filter: blur(20px); border-radius: 16px; padding: 32px; border: 1px solid rgba(255,255,255,0.1); text-align: center; transition: transform 0.3s, border-color 0.3s; }
  .geekbar-tech__card:hover { transform: translateY(-4px); border-color: rgba(0,229,255,0.3); }
  .geekbar-tech__icon { width: 60px; height: 60px; margin: 0 auto 20px; border-radius: 12px; background: rgba(0,229,255,0.1); display: flex; align-items: center; justify-content: center; }
  .geekbar-tech__icon svg { width: 32px; height: 32px; stroke: #00E5FF; fill: none; stroke-width: 2; }
  .geekbar-tech__card-title { font-size: 1.2rem; font-weight: 700; color: white; margin-bottom: 12px; text-transform: uppercase; }
  .geekbar-tech__card-desc { color: #A0A5B5; font-size: 0.95rem; line-height: 1.6; }
  @media screen and (max-width: 990px) { .geekbar-tech__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 750px) { .geekbar-tech__grid { grid-template-columns: 1fr; } }
</style>

<div class="gk-section geekbar-tech" style="background: var(--gk-bg-dark, #10121A);">
  <div class="page-width">
    {% if section.settings.heading != blank %}
    <h2 class="gk-section-title gk-fade-in" style="text-align: center; color: white; margin-bottom: 20px;">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
    <p class="gk-section-subtitle gk-fade-in" style="text-align: center; color: #A0A5B5; margin-bottom: 50px;">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.settings.image != blank %}
    <div class="geekbar-tech__image gk-fade-in">
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '100vw' }}
    </div>
    {% endif %}

    <div class="geekbar-tech__grid">
      {% for block in section.blocks %}
      <div class="geekbar-tech__card gk-fade-in" {{ block.shopify_attributes }}>
        <div class="geekbar-tech__icon">
          {% case block.settings.icon %}
            {% when 'chip' %}
              <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>
            {% when 'screen' %}
              <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            {% when 'battery' %}
              <svg viewBox="0 0 24 24"><rect x="2" y="7" width="16" height="10" rx="2" ry="2"></rect><line x1="22" y1="11" x2="22" y2="13"></line></svg>
            {% when 'coil' %}
              <svg viewBox="0 0 24 24"><path d="M4 2v20"></path><path d="M20 2v20"></path><path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path></svg>
            {% when 'airflow' %}
              <svg viewBox="0 0 24 24"><path d="M12 4c-4.4 0-8 3.6-8 8s3.6 8 8 8 8-3.6 8-8-3.6-8-8-8z"></path><path d="M12 8v4l3 3"></path></svg>
            {% when 'bolt' %}
              <svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            {% else %}
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle></svg>
          {% endcase %}
        </div>
        <h3 class="geekbar-tech__card-title">{{ block.settings.title }}</h3>
        <p class="geekbar-tech__card-desc">{{ block.settings.description }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "GeekBar Tech Showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "INNOVATION & TECHNOLOGY"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "chip", "label": "Chip" },
            { "value": "screen", "label": "Screen" },
            { "value": "battery", "label": "Battery" },
            { "value": "coil", "label": "Coil" },
            { "value": "airflow", "label": "Airflow" },
            { "value": "bolt", "label": "Bolt" }
          ],
          "default": "chip"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Feature description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GeekBar Tech Showcase",
      "blocks": [
        { "type": "feature", "settings": { "icon": "chip", "title": "Advanced Chipset" } },
        { "type": "feature", "settings": { "icon": "screen", "title": "Smart Display" } },
        { "type": "feature", "settings": { "icon": "battery", "title": "Long-lasting Battery" } },
        { "type": "feature", "settings": { "icon": "coil", "title": "Mesh Coil Tech" } }
      ]
    }
  ]
}
{% endschema %}
