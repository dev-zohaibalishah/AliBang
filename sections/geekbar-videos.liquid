<style>
  .geekbar-videos {
    background: var(--gk-bg-primary, #0B0D12);
    padding: 80px 0;
    color: white;
    overflow: hidden;
  }
  .geekbar-videos .page-width {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 5%;
  }
  .geekbar-videos h2 {
    font-size: 2.5rem;
    font-family: var(--gk-font-heading, 'Outfit');
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 40px;
    text-align: center;
  }

  /* Swiper Carousel */
  .geekbar-videos__swiper {
    overflow: hidden;
    padding-bottom: 50px;
    position: relative;
  }

  .geekbar-videos__swiper .swiper-slide {
    width: 380px;
    flex-shrink: 0;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  .geekbar-videos__card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--gk-bg-card, #1A1D28);
    border: 1px solid var(--gk-border-color, rgba(255,255,255,0.08));
    cursor: pointer;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .geekbar-videos__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.4);
  }

  .geekbar-videos__thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
  }
  .geekbar-videos__thumb img,
  .geekbar-videos__thumb svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .geekbar-videos__card:hover .geekbar-videos__thumb img {
    transform: scale(1.06);
  }

  /* Play button overlay */
  .geekbar-videos__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(1);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(218, 28, 29, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 0 20px rgba(218, 28, 29, 0.4);
  }
  .geekbar-videos__play svg {
    width: 22px;
    height: 22px;
    fill: #fff;
    margin-left: 3px;
  }
  .geekbar-videos__card:hover .geekbar-videos__play {
    transform: translate(-50%, -50%) scale(1.15);
    box-shadow: 0 0 30px rgba(218, 28, 29, 0.6);
  }

  /* Gradient overlay at bottom of thumb */
  .geekbar-videos__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(to top, rgba(0,0,0,0.85), transparent);
    z-index: 2;
    pointer-events: none;
  }

  .geekbar-videos__info {
    padding: 20px;
  }
  .geekbar-videos__title {
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 8px;
    line-height: 1.4;
  }
  .geekbar-videos__link {
    color: var(--gk-accent-cyan, #DA1C1D);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.3s ease;
  }
  .geekbar-videos__link:hover {
    color: #fff;
  }
  .geekbar-videos__link svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
  }

  /* Navigation arrows */
  .geekbar-videos__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
  }
  .geekbar-videos__nav-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }
  .geekbar-videos__nav-btn:hover {
    background: rgba(218,28,29,0.2);
    border-color: #DA1C1D;
    box-shadow: 0 0 16px rgba(218,28,29,0.3);
  }
  .geekbar-videos__nav-btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
  }
  .geekbar-videos__nav-btn.swiper-button-disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* Swiper pagination */
  .geekbar-videos__swiper .swiper-pagination {
    position: relative;
    bottom: auto;
    margin-top: 24px;
    text-align: center;
  }
  .geekbar-videos__swiper .swiper-pagination-bullet {
    width: 10px;
    height: 10px;
    background: rgba(255,255,255,0.25);
    opacity: 1;
    transition: all 0.3s ease;
  }
  .geekbar-videos__swiper .swiper-pagination-bullet-active {
    background: #DA1C1D;
    box-shadow: 0 0 10px rgba(218,28,29,0.5);
    transform: scale(1.2);
  }

  /* Video popup */
  .video-pop {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.92);
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(8px);
  }
  .video-pop .main {
    position: relative;
    width: 80%;
    max-width: 1000px;
    aspect-ratio: 16/9;
  }
  .video-pop video {
    width: 100%;
    height: 100%;
    background: #000;
    border-radius: 12px;
  }
  .video-pop .btn-close {
    position: absolute;
    top: -50px;
    right: 0;
    width: 40px;
    height: 40px;
    background: rgba(218,28,29,0.9);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-weight: bold;
    font-size: 1.4rem;
    transition: background 0.3s ease;
    border: none;
  }
  .video-pop .btn-close:hover {
    background: #DA1C1D;
  }

  @media screen and (max-width: 990px) {
    .geekbar-videos__swiper .swiper-slide {
      width: 320px;
    }
  }
  @media screen and (max-width: 749px) {
    .geekbar-videos { padding: 50px 0; }
    .geekbar-videos h2 { font-size: 1.8rem; margin-bottom: 30px; }
    .geekbar-videos__swiper .swiper-slide {
      width: 85vw;
    }
    .video-pop .main {
      width: 95%;
    }
    .video-pop .btn-close {
      top: -45px;
    }
    .geekbar-videos__nav-btn {
      width: 36px;
      height: 36px;
    }
    .geekbar-videos__nav-btn svg {
      width: 16px;
      height: 16px;
    }
  }
</style>

<div class="geekbar-videos" id="geekbar-videos">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="gk-fade-in">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="geekbar-videos__swiper swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="geekbar-videos__card" data-video="{{ block.settings.video_url }}">
              <div class="geekbar-videos__thumb">
                {% if block.settings.image %}
                  {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
                {% else %}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
                <div class="geekbar-videos__overlay"></div>
                {% if block.settings.video_url != blank %}
                  <div class="geekbar-videos__play">
                    <svg viewBox="0 0 24 24"><polygon points="6,3 20,12 6,21"></polygon></svg>
                  </div>
                {% endif %}
              </div>
              <div class="geekbar-videos__info">
                {% if block.settings.title != blank %}
                  <h3 class="geekbar-videos__title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.link != blank and block.settings.link_text != blank %}
                  <a href="{{ block.settings.link }}" class="geekbar-videos__link">
                    {{ block.settings.link_text }}
                    <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="swiper-pagination"></div>
    </div>

    <div class="geekbar-videos__nav">
      <button class="geekbar-videos__nav-btn geekbar-videos__prev" aria-label="Previous video">
        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="geekbar-videos__nav-btn geekbar-videos__next" aria-label="Next video">
        <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>
</div>

<div class="video-pop" id="videoPopup">
  <div class="main">
    <button class="btn-close" id="closeVideo" aria-label="Close video">&times;</button>
    <video id="popupVideo" controls playsinline></video>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof Swiper === 'undefined') return;

    var videosSwiper = new Swiper('.geekbar-videos__swiper', {
      slidesPerView: 'auto',
      spaceBetween: 24,
      loop: true,
      speed: 600,
      autoplay: {
        delay: 3500,
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      },
      pagination: {
        el: '.geekbar-videos__swiper .swiper-pagination',
        clickable: true
      },
      navigation: {
        prevEl: '.geekbar-videos__prev',
        nextEl: '.geekbar-videos__next'
      }
    });

    /* Video popup */
    var videoCards = document.querySelectorAll('.geekbar-videos__card[data-video]');
    var videoPop = document.getElementById('videoPopup');
    var popupVideo = document.getElementById('popupVideo');
    var closeBtn = document.getElementById('closeVideo');

    if (!videoPop || !popupVideo || !closeBtn) return;

    videoCards.forEach(function(card) {
      card.addEventListener('click', function(e) {
        if (e.target.closest('.geekbar-videos__link')) return;
        var videoUrl = this.getAttribute('data-video');
        if (videoUrl) {
          popupVideo.src = videoUrl;
          videoPop.style.display = 'flex';
          popupVideo.play();
        }
      });
    });

    closeBtn.addEventListener('click', function() {
      videoPop.style.display = 'none';
      popupVideo.pause();
      popupVideo.src = '';
    });

    videoPop.addEventListener('click', function(e) {
      if (e.target === videoPop) {
        videoPop.style.display = 'none';
        popupVideo.pause();
        popupVideo.src = '';
      }
    });
  });
</script>

{% schema %}
{
  "name": "GeekBar Videos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "VIDEOS"
    }
  ],
  "blocks": [
    {
      "type": "video_slide",
      "name": "Video Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover Image"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video File URL (MP4)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product Showcase"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "LEARN MORE"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GeekBar Videos",
      "blocks": [
        { "type": "video_slide" },
        { "type": "video_slide" },
        { "type": "video_slide" }
      ]
    }
  ]
}
{% endschema %}
