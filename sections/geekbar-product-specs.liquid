<style>
  .gk-specs {
    background: var(--gk-bg-primary, #0B0D12);
    padding: 60px 0;
  }

  .gk-specs__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .gk-specs__heading {
    font-family: var(--gk-font-heading, 'Outfit', sans-serif);
    color: var(--gk-text-primary, #FFFFFF);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin: 0 0 40px;
  }

  .gk-specs__heading::after {
    content: '';
    display: block;
    width: 60px;
    height: 3px;
    background: var(--gk-accent-cyan, #DA1C1D);
    margin: 16px auto 0;
    border-radius: 2px;
  }

  .gk-specs__table {
    width: 100%;
    border-collapse: collapse;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .gk-specs__table tr:nth-child(odd) {
    background: var(--gk-bg-card, #1A1D28);
  }

  .gk-specs__table tr:nth-child(even) {
    background: var(--gk-bg-secondary, #10121A);
  }

  .gk-specs__table td {
    padding: 18px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--gk-font-body, 'Inter', sans-serif);
    font-size: 1.5rem;
    line-height: 1.5;
  }

  .gk-specs__table tr:last-child td {
    border-bottom: none;
  }

  .gk-specs__label {
    color: var(--gk-text-muted, #6B7085);
    text-transform: uppercase;
    font-size: 1.3rem;
    letter-spacing: 0.1em;
    font-weight: 600;
    width: 40%;
    vertical-align: middle;
  }

  .gk-specs__value {
    color: var(--gk-text-primary, #FFFFFF);
    font-weight: 500;
    vertical-align: middle;
  }

  @media (max-width: 749px) {
    .gk-specs {
      padding: 40px 0;
    }

    .gk-specs__table td {
      padding: 14px 16px;
      font-size: 1.4rem;
    }

    .gk-specs__label {
      font-size: 1.2rem;
      width: 45%;
    }
  }
</style>

<section class="gk-specs" id="product-specs">
  <div class="gk-specs__container page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="gk-specs__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <table class="gk-specs__table">
      <tbody>
        {%- for i in (1..8) -%}
          {%- assign label_key = 'spec_label_' | append: i -%}
          {%- assign value_key = 'spec_value_' | append: i -%}
          {%- assign label = section.settings[label_key] -%}
          {%- assign value = section.settings[value_key] -%}
          {%- if label != blank and value != blank -%}
            <tr>
              <td class="gk-specs__label">{{ label }}</td>
              <td class="gk-specs__value">{{ value }}</td>
            </tr>
          {%- endif -%}
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</section>

