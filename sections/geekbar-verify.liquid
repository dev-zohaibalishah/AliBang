{%- style -%}
.gk-verify-section {
  padding: 80px 0;
  background: var(--gk-bg-primary, #0B0D12);
  color: #ffffff;
  font-family: 'Inter', sans-serif;
}

.gk-verify__container {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 20px;
}

.gk-verify__card {
  background: var(--gk-bg-card, #1A1D28);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  padding: 50px;
  text-align: center;
  box-shadow: 0 10px 40px rgba(0,0,0,0.3);
}

.gk-verify__badge {
  display: inline-flex;
  padding: 6px 16px;
  background: rgba(0, 229, 255, 0.1);
  color: #00E5FF;
  border: 1px solid rgba(0, 229, 255, 0.2);
  border-radius: 30px;
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 24px;
}

.gk-verify__title {
  font-family: 'Outfit', sans-serif;
  font-size: 2.5rem;
  font-weight: 800;
  text-transform: uppercase;
  margin-bottom: 16px;
  letter-spacing: 0.05em;
}

.gk-verify__subtitle {
  color: #a0a5b5;
  font-size: 1rem;
  line-height: 1.6;
  max-width: 600px;
  margin: 0 auto 40px;
}

.gk-verify__steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 40px;
  text-align: left;
}

.gk-verify__step {
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.04);
  border-radius: 12px;
  padding: 20px;
  transition: border-color 0.3s ease;
}

.gk-verify__step:hover {
  border-color: rgba(0, 229, 255, 0.2);
}

.gk-verify__step-num {
  color: #00E5FF;
  font-family: 'Outfit', sans-serif;
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 10px;
}

.gk-verify__step-text {
  color: #a0a5b5;
  font-size: 0.85rem;
  line-height: 1.5;
}

.gk-verify__form {
  max-width: 500px;
  margin: 0 auto;
}

.gk-verify__input-group {
  position: relative;
  margin-bottom: 20px;
}

.gk-verify__input {
  width: 100%;
  padding: 16px 20px;
  background: rgba(11, 13, 18, 0.6) !important;
  border: 1px solid rgba(255, 255, 255, 0.1) !important;
  border-radius: 8px;
  color: #ffffff;
  font-size: 1.2rem;
  letter-spacing: 0.08em;
  text-align: center;
  transition: all 0.3s ease;
}

.gk-verify__input::placeholder {
  font-size: 1rem;
  letter-spacing: 0.05em;
  color: rgba(255,255,255,0.3);
}

.gk-verify__input:focus {
  border-color: #00E5FF !important;
  box-shadow: 0 0 15px rgba(0, 229, 255, 0.2) !important;
}

.gk-verify__btn {
  width: 100%;
  padding: 16px 32px !important;
  font-size: 1rem !important;
}

/* Result States */
.gk-verify__result {
  margin-top: 30px;
  border-radius: 12px;
  padding: 24px;
  display: none;
  text-align: left;
}

.gk-verify__result.visible {
  display: block;
}

.gk-verify__result--loading {
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.08);
  text-align: center;
}

.gk-verify__result--success {
  background: rgba(57, 255, 20, 0.05);
  border: 1px solid rgba(57, 255, 20, 0.2);
  color: #39FF14;
}

.gk-verify__result--error {
  background: rgba(255, 0, 229, 0.05);
  border: 1px solid rgba(255, 0, 229, 0.2);
  color: #ff00e5;
}

.gk-verify__result-title {
  font-family: 'Outfit', sans-serif;
  font-size: 1.2rem;
  font-weight: 700;
  margin-bottom: 8px;
  text-transform: uppercase;
}

.gk-verify__result-desc {
  font-size: 0.9rem;
  line-height: 1.6;
  color: #a0a5b5;
}

/* Loading Spinner */
.gk-verify__spinner {
  display: inline-block;
  width: 30px;
  height: 30px;
  border: 3px solid rgba(255,255,255,0.1);
  border-radius: 50%;
  border-top-color: #00E5FF;
  animation: gk-spin 1s ease-in-out infinite;
  margin-bottom: 12px;
}

@keyframes gk-spin {
  to { transform: rotate(360deg); }
}

@media (max-width: 750px) {
  .gk-verify__card {
    padding: 30px 20px;
  }
  .gk-verify__steps {
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .gk-verify__title {
    font-size: 1.8rem;
  }
}
{%- endstyle -%}

<div class="gk-verify-section">
  <div class="gk-verify__container">
    <div class="gk-verify__card">
      <span class="gk-verify__badge">Official Security</span>
      <h2 class="gk-verify__title">{{ section.settings.heading }}</h2>
      <p class="gk-verify__subtitle">{{ section.settings.subheading }}</p>
      
      <div class="gk-verify__steps">
        <div class="gk-verify__step">
          <div class="gk-verify__step-num">01</div>
          <div class="gk-verify__step-text">Locate the scratch-off label on the side of your AliBang device packaging box.</div>
        </div>
        <div class="gk-verify__step">
          <div class="gk-verify__step-num">02</div>
          <div class="gk-verify__step-text">Gently scratch off the silver coating to reveal the official 18-digit verification code.</div>
        </div>
        <div class="gk-verify__step">
          <div class="gk-verify__step-num">03</div>
          <div class="gk-verify__step-text">Enter the numeric code in the field below to immediately check its authenticity status.</div>
        </div>
      </div>
      
      <div class="gk-verify__form">
        <div class="gk-verify__input-group">
          <input type="text" id="VerifyInput" class="gk-verify__input" placeholder="Enter 18-digit security code" maxlength="18">
        </div>
        <button id="VerifyBtn" class="button gk-verify__btn">Verify Product Code</button>
      </div>
      
      <!-- Result Boxes -->
      <div id="ResultLoading" class="gk-verify__result gk-verify__result--loading">
        <div class="gk-verify__spinner"></div>
        <p style="margin: 0; color: #a0a5b5;">Checking authenticity database. Please wait...</p>
      </div>
      
      <div id="ResultSuccess" class="gk-verify__result gk-verify__result--success">
        <div class="gk-verify__result-title">✓ Verified Genuine Product</div>
        <div class="gk-verify__result-desc">
          Authenticity verified successfully! This is a genuine <strong>AliBang</strong> product. Thank you for buying authentic hardware.
          <br><span style="font-size:0.8rem; margin-top:8px; display:inline-block; color:rgba(255,255,255,0.4)">Verification Date: <span id="VerifyDate"></span></span>
        </div>
      </div>
      
      <div id="ResultError" class="gk-verify__result gk-verify__result--error">
        <div class="gk-verify__result-title">⚠ Counterfeit Warning / Invalid Code</div>
        <div id="ErrorDesc" class="gk-verify__result-desc">
          The code you entered is invalid. Please double check the 18 digits. If you believe this is an error, please contact official support.
        </div>
      </div>
      
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const input = document.getElementById('VerifyInput');
    const btn = document.getElementById('VerifyBtn');
    const resultLoading = document.getElementById('ResultLoading');
    const resultSuccess = document.getElementById('ResultSuccess');
    const resultError = document.getElementById('ResultError');
    const errorDesc = document.getElementById('ErrorDesc');
    const verifyDate = document.getElementById('VerifyDate');
    
    function resetResults() {
      resultLoading.classList.remove('visible');
      resultSuccess.classList.remove('visible');
      resultError.classList.remove('visible');
    }
    
    btn.addEventListener('click', function() {
      resetResults();
      const code = input.value.trim();
      
      // Validation checks
      if (code === '') {
        resultError.classList.add('visible');
        errorDesc.innerHTML = 'Please enter your security code to verify.';
        return;
      }
      
      if (!/^\d{18}$/.test(code)) {
        resultError.classList.add('visible');
        errorDesc.innerHTML = 'Invalid format! The verification security code must be exactly 18 numeric digits.';
        return;
      }
      
      // Show loading
      resultLoading.classList.add('visible');
      
      // Simulate verification api call
      setTimeout(function() {
        resultLoading.classList.remove('visible');
        
        // Mock counterfeit list
        const flagList = ['111111111111111111', '123456789012345678', '000000000000000000'];
        
        if (flagList.includes(code)) {
          resultError.classList.add('visible');
          errorDesc.innerHTML = '<strong>WARNING:</strong> This code has been flagged as fake or has been verified too many times (Limit exceeded). If you purchased this device recently, please return it to the retailer or file a counterfeit report.';
        } else {
          // Success
          const now = new Date();
          verifyDate.textContent = now.toLocaleString();
          resultSuccess.classList.add('visible');
        }
      }, 1500);
    });
    
    // Only allow numbers in input
    input.addEventListener('input', function(e) {
      this.value = this.value.replace(/[^0-9]/g, '');
    });
  });
</script>

{% schema %}
{
  "name": "Verify Product Widget",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AUTHENTICITY VERIFICATION"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Protect yourself against counterfeit products. Verify your genuine AliBang device below."
    }
  ],
  "presets": [
    {
      "name": "Verify Product Widget"
    }
  ]
}
{% endschema %}
