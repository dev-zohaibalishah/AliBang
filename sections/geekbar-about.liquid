<style>
  .home-about-container {
    position: relative;
    height: 150vh; /* Extra height to allow scroll animation */
    background: #000;
  }
  .home-about-container .sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .home-about-container video {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    transform: translateX(-50%) translateY(-50%);
    object-fit: cover;
    z-index: 1;
    opacity: 0.7;
  }
  .home-about-container .logo-mask {
    position: absolute;
    z-index: 2;
    width: 30vw;
    max-width: 500px;
    transition: transform 0.1s linear, opacity 0.3s;
  }
  .home-about-container .content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: white;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s, transform 0.5s;
  }
  .home-about-container .inner {
    max-width: 800px;
    padding: 0 20px;
  }
  .home-about-container p {
    font-size: clamp(1.2rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 10px;
    text-transform: uppercase;
    font-family: var(--gk-font-heading, 'Outfit');
  }
  .home-about-container .text1,
  .home-about-container .text2,
  .home-about-container .text3 {
    opacity: 0.3;
    transition: opacity 0.3s;
  }
  .home-about-container .view-more {
    display: inline-block;
    margin-top: 30px;
    color: var(--gk-accent-cyan, #DA1C1D);
    text-decoration: none;
    font-weight: bold;
    border: 1px solid var(--gk-accent-cyan, #DA1C1D);
    padding: 12px 30px;
    border-radius: 30px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: all 0.3s;
  }
  .home-about-container .view-more:hover {
    background: var(--gk-accent-cyan, #DA1C1D);
    color: #FFF;
  }
</style>

<div class="home-about-container" id="geekbar-about">
  <div class="sticky">
    {% if section.settings.bg_video != blank %}
      <video muted playsinline loop autoplay src="{{ section.settings.bg_video }}"></video>
    {% else %}
      <video muted playsinline loop autoplay src="https://oss.geekbar.com/common/output4.mp4"></video>
    {% endif %}
    
    {% if section.settings.logo_mask != blank %}
      {{ section.settings.logo_mask | image_url: width: 800 | image_tag: class: 'logo-mask gk-logo-anim' }}
    {% else %}
      <img src="https://oss.geekbar.com/common/logo_mask.png" alt="GeekBar Logo" class="logo-mask gk-logo-anim" style="filter: invert(1);">
    {% endif %}

    <div class="content gk-content-anim">
      <div class="inner">
        <p class="text1 gk-text1">{{ section.settings.text_1 | newline_to_br }}</p>
        <p class="text2 gk-text2">{{ section.settings.text_2 }}</p>
        <p class="text3 gk-text3">{{ section.settings.text_3 }}</p>
        {% if section.settings.button_link != blank %}
          <a href="{{ section.settings.button_link }}" class="view-more">{{ section.settings.button_text }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '.home-about-container',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1,
        }
      });

      tl.to('.gk-logo-anim', { scale: 5, opacity: 0, duration: 2 })
        .to('.gk-content-anim', { opacity: 1, y: 0, duration: 1 }, "-=1")
        .to('.gk-text1', { opacity: 1, duration: 1 })
        .to('.gk-text1', { opacity: 0.5, duration: 1 })
        .to('.gk-text2', { opacity: 1, duration: 1 }, "<")
        .to('.gk-text2', { opacity: 0.5, duration: 1 })
        .to('.gk-text3', { opacity: 1, duration: 1 }, "<");
    }
  });
</script>

{% schema %}
{
  "name": "GeekBar About Video",
  "settings": [
    {
      "type": "url",
      "id": "bg_video",
      "label": "Background Video URL (MP4)"
    },
    {
      "type": "image_picker",
      "id": "logo_mask",
      "label": "Logo Mask Image"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Text Line 1",
      "default": "GEEKBAR\nTo deeply satisfy vapers' needs by offering the most tasteful, compact,"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Text Line 2",
      "default": "and safe disposable vape products across brands,"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Text Line 3",
      "default": "designed with high-quality materials and manufacturing."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "VIEW MORE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "GeekBar About Video"
    }
  ]
}
{% endschema %}
