<style>
  .geekbar-news__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; }
  .geekbar-news__card { background: #1A1D28; border-radius: 16px; overflow: hidden; border: 1px solid rgba(255,255,255,0.08); transition: transform 0.3s, box-shadow 0.3s; }
  .geekbar-news__card:hover { transform: translateY(-6px); box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
  .geekbar-news__image { aspect-ratio: 16/10; overflow: hidden; }
  .geekbar-news__image img, .geekbar-news__image svg { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; background: #2A2E3D; }
  .geekbar-news__card:hover .geekbar-news__image img, .geekbar-news__card:hover .geekbar-news__image svg { transform: scale(1.05); }
  .geekbar-news__body { padding: 24px; }
  .geekbar-news__date { color: #6B7085; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px; display: block; }
  .geekbar-news__title { color: white; font-size: 1.2rem; font-weight: 600; margin: 0 0 12px; line-height: 1.4; }
  .geekbar-news__excerpt { color: #A0A5B5; font-size: 0.9rem; line-height: 1.6; margin: 0 0 16px; }
  .geekbar-news__link { color: #DA1C1D; font-size: 0.9rem; text-decoration: none; font-weight: 500; }
  .geekbar-news__link:hover { text-decoration: underline; }
  @media screen and (max-width: 990px) { .geekbar-news__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 750px) { .geekbar-news__grid { grid-template-columns: 1fr; } }
</style>

<div class="gk-section geekbar-news">
  <div class="page-width">
    {% if section.settings.heading != blank %}
    <h2 class="gk-section-title gk-fade-in" style="text-align: center; color: white;">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
    <p class="gk-section-subtitle gk-fade-in" style="text-align: center; color: #A0A5B5;">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="geekbar-news__grid">
      {% if section.settings.blog != blank and blogs[section.settings.blog].articles.size > 0 %}
        {% for article in blogs[section.settings.blog].articles limit: 3 %}
        <div class="geekbar-news__card gk-fade-in">
          <div class="geekbar-news__image">
            {% if article.image %}
            {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
            {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <div class="geekbar-news__body">
            <span class="geekbar-news__date">{{ article.published_at | date: "%B %d, %Y" }}</span>
            <h3 class="geekbar-news__title">{{ article.title }}</h3>
            <p class="geekbar-news__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
            <a href="{{ article.url }}" class="geekbar-news__link">Read More &rarr;</a>
          </div>
        </div>
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
        <div class="geekbar-news__card gk-fade-in" {{ block.shopify_attributes }}>
          <div class="geekbar-news__image">
            {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
            {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <div class="geekbar-news__body">
            <span class="geekbar-news__date">{{ block.settings.date }}</span>
            <h3 class="geekbar-news__title">{{ block.settings.title }}</h3>
            <p class="geekbar-news__excerpt">{{ block.settings.excerpt }}</p>
            <a href="{{ block.settings.link }}" class="geekbar-news__link">Read More &rarr;</a>
          </div>
        </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "GeekBar News Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LATEST NEWS & EVENTS"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Article",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "October 10, 2023"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "News Article Title"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Excerpt",
          "default": "Short description or excerpt of the news article goes here."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GeekBar News Grid",
      "blocks": [
        { "type": "article" },
        { "type": "article" },
        { "type": "article" }
      ]
    }
  ]
}
{% endschema %}
