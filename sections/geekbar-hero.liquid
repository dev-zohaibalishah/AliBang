{{ 'geekbar-hero.css' | asset_url | stylesheet_tag }}
<div class="geekbar-hero" id="geekbar-hero">
  <!-- Cosmic background effect -->
  <div class="geekbar-hero__cosmic"></div>
  
  <!-- Slides -->
  {% for block in section.blocks %}
  <div class="geekbar-hero__slide {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }} data-slide-index="{{ forloop.index0 }}">
    {% if block.settings.image %}
    <div class="geekbar-hero__bg">
      {{ block.settings.image | image_url: width: 1920 | image_tag: loading: 'eager', class: 'geekbar-hero__bg-img', sizes: '100vw' }}
    </div>
    {% else %}
    <div class="geekbar-hero__bg">
      <img src="{{ 'hero-banner.jpg' | asset_url }}" alt="AliBang Vape" class="geekbar-hero__bg-img" loading="eager" style="width:100%;height:100%;object-fit:cover;">
    </div>
    {% endif %}
    <div class="geekbar-hero__overlay"></div>
    <div class="geekbar-hero__content page-width">
      {% if block.settings.tag != blank %}
      <span class="geekbar-hero__tag">{{ block.settings.tag }}</span>
      {% endif %}
      <h2 class="geekbar-hero__title">{{ block.settings.heading }}</h2>
      {% if block.settings.subheading != blank %}
      <p class="geekbar-hero__subtitle">{{ block.settings.subheading }}</p>
      {% endif %}
      {% if block.settings.button_label != blank %}
      <a href="{{ block.settings.button_link }}" class="button geekbar-hero__cta">{{ block.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
  {% endfor %}
  
  <!-- Navigation dots -->
  {% if section.blocks.size > 1 %}
  <div class="geekbar-hero__dots">
    {% for block in section.blocks %}
    <button class="geekbar-hero__dot {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
    {% endfor %}
  </div>
  
  <!-- Arrows -->
  <div class="geekbar-hero__arrows">
    <button class="geekbar-hero__arrow geekbar-hero__arrow--prev" aria-label="Previous slide">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <button class="geekbar-hero__arrow geekbar-hero__arrow--next" aria-label="Next slide">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "GeekBar Hero",
  "tag": "section",
  "class": "geekbar-hero-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "New Arrival"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "EXPLORE THE FUTURE OF VAPING"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "Experience cutting-edge technology..."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Explore Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GeekBar Hero",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
