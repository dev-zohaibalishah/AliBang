{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "thumbnail_slider",
        "media_position": "left",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "product_features": {
      "type": "geekbar-product-features",
      "blocks": {
        "feature_1": {
          "type": "feature",
          "settings": {
            "tag": "TECHNOLOGY",
            "heading": "3D CURVED SCREEN",
            "description": "World's first 3D curved full screen display with real-time battery and e-liquid monitoring."
          }
        },
        "feature_2": {
          "type": "feature",
          "settings": {
            "tag": "PERFORMANCE",
            "heading": "DUAL MESH COIL SYSTEM",
            "description": "Advanced dual mesh coil heating technology delivers richer, more consistent flavor with every puff."
          }
        },
        "feature_3": {
          "type": "feature",
          "settings": {
            "tag": "POWER",
            "heading": "RAPID USB-C CHARGING",
            "description": "Get back to full power quickly with USB-C fast charging technology."
          }
        }
      },
      "block_order": ["feature_1", "feature_2", "feature_3"],
      "settings": {
        "heading": "KEY FEATURES"
      }
    },
    "product_specs": {
      "type": "geekbar-product-specs",
      "settings": {
        "heading": "SPECIFICATIONS"
      }
    },
    "collapsible_content": {
      "type": "collapsible-content",
      "blocks": {
        "faq_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does the battery last?",
            "row_content": "<p>Our devices feature a high-capacity battery that can last for days depending on usage.</p>"
          }
        },
        "faq_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I charge the device?",
            "row_content": "<p>Use the provided USB-C cable for rapid charging. Connect it to any standard USB power adapter.</p>"
          }
        },
        "faq_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is the device water-resistant?",
            "row_content": "<p>Our devices are designed to withstand minor splashes, but are not fully waterproof.</p>"
          }
        }
      },
      "block_order": ["faq_1", "faq_2", "faq_3"],
      "settings": {
        "heading": "FAQ",
        "color_scheme": "",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "related_products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "product_features",
    "product_specs",
    "collapsible_content",
    "related_products"
  ]
}